{
  "manifest_version": 3,
  "name": "MagangHub Auto-Draft Saver",
  "version": "1.0.3",
  "description": "Menyimpan sementara dan memulihkan draft laporan harian/mingguan di Monev MagangHub.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://monev.maganghub.kemnaker.go.id/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://monev.maganghub.kemnaker.go.id/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "https://monev.maganghub.kemnaker.go.id/*"
      ]
    }
  ]
}